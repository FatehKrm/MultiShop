@model UpdateCommentDto
@{
    ViewData["Title"] = "UpdateComment";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}
<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">
                <h4>yorum güncelleme sayfası</h4>
                <hr />
                <div class="bs-example" data-example-id="bordered-table">
                    <form method="post">
                        <input type="hidden"  asp-for="UserCommentId" class="form-control" />
                        <input type="hidden"  asp-for="ProductId" class="form-control" />
                        <br />
                        <label>Yorumu yazanın adı soyadı</label>
                        <input type="text" asp-for="NameSurname" class="form-control" />
                        <br />
                        <label>Kullanıcı Görsel</label>
                        <input type="text" asp-for="ImageUrl" class="form-control" />
                        <br />
                        <label>Mail adresi</label>
                        <input type="text" asp-for="Email" class="form-control" />
                        <br />
                        <label>Puan</label>
                        <input type="number" asp-for="Raiting" class="form-control" />
                        <br />
                        <label>Yorum tarihi</label>
                        <input type="date" asp-for="CreatedDate" class="form-control" />
                        <br />
                        <label>Yorum</label>
                        <textarea asp-for="Detail" rows="3" class="form-control"></textarea>
                        <br />
                        <button class="btn btn-success">yorum güncelle</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

