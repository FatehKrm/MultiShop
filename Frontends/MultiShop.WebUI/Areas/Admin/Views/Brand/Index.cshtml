@model IEnumerable<MultiShop.DtoLayer.CatalogDtos.BrandDtos.ResultBrandDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
    int coutn = 0;
}

<h1>Index</h1>
<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">
                <h4>Kategori Listesi</h4>
                <div class="bs-example" data-example-id="bordered-table">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Marka Adı</th>
                                <th>Marka görsel</th>
                                <th>Sil</th>
                                <th>Güncelle</th>
                            </tr>
                        </thead>
                        @*Api consume will be here *@  
                        <tbody>
                            @foreach (var item in Model)
                            {
                                coutn++;
                                <tr>
                                    <th scope="row">@coutn</th>
                                    <td>@item.BrandName</td>
                                    <td><img src="@item.ImageUrl" style="width:50px; height:50px;"/></td>
                                    <td><a href="/Admin/Brand/DeleteBrand/@item.BrandId" class="btn btn-danger">Sil</a></td>
                                    <td><a href="/Admin/Brand/UpdateBrand/@item.BrandId" class="btn btn-success">Güncelle</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <a href="/Admin/Brand/CreateBrand" class="btn btn-primary">Yeni marka girişi</a>
                </div>
            </div>
        </div>
    </div>
</section>
