@model MultiShop.DtoLayer.CatalogDtos.BrandDtos.CreateBrandDto

@{
    ViewData["Title"] = "CreateBrand";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">
                <h4>Marka ekleme sayfası</h4>
                <p>Marka ile ilgili ekleme işlemlerinizi aşağıdaki tablo üzerinden gerçekleştirebilirsiniz</p>
                <div class="bs-example" data-example-id="bordered-table">
                    <form method="post">
                        <label>Marka adı</label>
                        <input type="text" name="BrandName" class="form-control" />
                        <br />
                        <label>Görsel yolu</label>
                        <input type="text" name="ImageUrl" class="form-control" />
                        <br />
                        <button class="btn btn-primary">Marka tanımla</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

